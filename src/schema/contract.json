{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CourseSiteContract",
  "description": "Explicit contractual specification between course.js, course.css, templates, and generated week HTML documents.",
  "exposed_functions": [
    "goDay",
    "toggleSidebar",
    "closeSidebar",
    "toggleTheme",
    "jumpTo",
    "completeDay",
    "quiz",
    "checkPredict",
    "toggleTask",
    "toggleSolution",
    "toggleCheck",
    "copyCode",
    "runCode",
    "openRepl",
    "openInColab",
    "closeCompilerModal",
    "renderMermaid"
  ],
  "required_page_ids": [
    "sidebar",
    "theme-btn"
  ],
  "required_day_structure": [
    "objectives",
    "day-header",
    "concept-map-flow",
    "hinglish",
    "theory",
    "predict-block",
    "tasks-section",
    "quiz",
    "flashcards",
    "gotcha",
    "takeaways",
    "resources",
    "complete-btn"
  ],
  "allowed_meta_badge_variants": [
    "g",
    "o",
    "p",
    "b",
    "pk",
    "t"
  ],
  "allowed_task_badge_variants": [
    "tb-easy",
    "tb-med",
    "tb-hard"
  ]
}
