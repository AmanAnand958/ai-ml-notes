{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WeekDataSchema",
  "type": "object",
  "required": ["week_number", "title", "days"],
  "properties": {
    "week_number": { "type": "integer", "minimum": 1, "maximum": 26 },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "description": { "type": "string" },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": ["string", "integer"] },
          "day_num": { "type": "integer" },
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "time_estimate": { "type": "string" },
          "difficulty": { "type": "string" },
          "xp": { "type": "integer", "default": 150 },
          "objectives": { "type": "array", "items": { "type": "string" } },
          "concept_flow": { "type": "array", "items": { "type": "string" } },
          "hinglish": { "type": "string" },
          "analogy": { "type": "string" },
          "theory_html": { "type": "string" },
          "predict": {
            "type": "object",
            "properties": {
              "question": { "type": "string" },
              "answer": { "type": "string" },
              "explanation": { "type": "string" },
              "code": { "type": "string" }
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title"],
              "properties": {
                "title": { "type": "string" },
                "badge": { "type": "string" },
                "time": { "type": "string" },
                "prompt_html": { "type": "string" },
                "done_when": { "type": "string" },
                "git_cmd": { "type": "string" },
                "sol_id": { "type": "string" },
                "solution_title": { "type": "string" },
                "solution_code": { "type": "string" },
                "solution_lang": { "type": "string", "default": "python" }
              }
            }
          },
          "quizzes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["question", "options"],
              "properties": {
                "question": { "type": "string" },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["text", "is_correct"],
                    "properties": {
                      "letter": { "type": "string" },
                      "text": { "type": "string" },
                      "is_correct": { "type": "boolean" }
                    }
                  }
                },
                "correct_fb": { "type": "string" },
                "wrong_fb": { "type": "string" }
              }
            }
          },
          "flashcards": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["front", "back"],
              "properties": {
                "front": { "type": "string" },
                "back": { "type": "string" }
              }
            }
          },
          "gotcha": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "takeaways": {
            "type": "object",
            "properties": {
              "hinglish_line": { "type": "string" },
              "bullets": { "type": "array", "items": { "type": "string" } }
            }
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "title": { "type": "string" },
                "desc": { "type": "string" },
                "url": { "type": "string" },
                "icon": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "toolkit": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "default": "toolkit" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "content_html": { "type": "string" },
        "xp": { "type": "integer", "default": 500 }
      }
    }
  }
}
